{
  "expo": {
    "name": "Gullak",
    "slug": "gullak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gullak",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.gullak.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FBF4EA"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "single",
      "name": "Gullak",
      "shortName": "Gullak",
      "themeColor": "#FBF4EA",
      "backgroundColor": "#FBF4EA"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FBF4EA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#FBF4EA"
  }
}
