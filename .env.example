# Gullak environment variables. Copy to .env and fill in; never commit real values.
# The API reads process.env directly, so export these in your shell or process manager.

# --- API server (artifacts/api-server) ---
PORT=8080
DATABASE_URL=postgres://gullak:change-me@localhost:5432/gullak
# Long random string. Also derives the relayer/desk wallet key unless OPERATOR_PRIVATE_KEY is set.
SESSION_SECRET=
# Optional: 0x-prefixed 32-byte hex key for the relayer/desk wallet (testnet only; fund it with test MON).
OPERATOR_PRIVATE_KEY=
# SHA-256 fingerprint(s) of the Android signing certificate, comma-separated (AA:BB:...).
# Served in /.well-known/assetlinks.json so the Android app can use passkeys on your domain.
ANDROID_CERT_SHA256=
# Optional: extra hosts accepted as the audience of sign-in tokens, comma-separated.
AUTH_EXTRA_AUDIENCES=
# Optional: Monad testnet RPC (defaults to the public endpoint).
MONAD_RPC_URL=
# Optional: set to true to stop this server from sending any transaction.
OPERATOR_WRITES_PAUSED=
# Optional: object storage bucket for the public APK download (Replit App Storage).
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
LOG_LEVEL=info

# --- App build (artifacts/gullak) ---
# Host that serves both the web app and /api; also the passkey rpId. No protocol.
EXPO_PUBLIC_DOMAIN=
# Optional: directory holding gullak-release.p12 and gullak-release.pass for build-android.sh.
GULLAK_SIGNING_DIR=
